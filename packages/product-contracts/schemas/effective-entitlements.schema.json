{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.blufield.cloud/v1/effective-entitlements.schema.json",
  "title": "EffectiveEntitlements",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenantId", "subscriptionStatus", "products", "version", "effectiveAt"],
  "properties": {
    "tenantId": { "type": "string", "format": "uuid" },
    "subscriptionStatus": { "enum": ["TRIALING", "ACTIVE", "PAST_DUE", "SUSPENDED", "CANCELED", "NONE"] },
    "products": { "type": "array", "items": { "$ref": "#/$defs/product" } },
    "version": { "type": "integer", "minimum": 0 },
    "effectiveAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "active", "capabilities", "limits"],
      "properties": {
        "key": { "enum": ["HRMS", "MAIL", "POS"] },
        "active": { "type": "boolean" },
        "capabilities": { "type": "object", "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]*$" }, "additionalProperties": { "type": "boolean" } },
        "limits": { "type": "object", "propertyNames": { "pattern": "^[a-z][a-zA-Z0-9]*$" }, "additionalProperties": { "type": "number", "minimum": 0 } }
      },
      "allOf": [
        {
          "if": { "properties": { "key": { "const": "HRMS" } }, "required": ["key"] },
          "then": { "properties": { "capabilities": { "propertyNames": { "enum": ["HRMS_EMPLOYEES", "HRMS_ORGANIZATION", "HRMS_ATTENDANCE", "HRMS_LEAVE", "HRMS_PAYROLL"] } } } }
        },
        {
          "if": { "properties": { "key": { "enum": ["MAIL", "POS"] } }, "required": ["key"] },
          "then": { "properties": { "capabilities": { "maxProperties": 0 } } }
        }
      ]
    }
  }
}
