{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.blufield.cloud/v1/product-manifest.schema.json",
  "title": "ProductManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "key", "name", "version", "frontendPathTemplate", "apiPath", "healthEndpoint", "readinessEndpoint", "permissions", "capabilities", "eventsConsumed", "eventsPublished"],
  "properties": {
    "contractVersion": { "const": "1.0" },
    "key": { "enum": ["HRMS", "MAIL", "POS"] },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "frontendPathTemplate": { "type": "string", "pattern": "^/\\{locale\\}/app/(hrms|mail|pos)$" },
    "apiPath": { "type": "string", "pattern": "^/api/(hrms|mail|pos)$" },
    "healthEndpoint": { "const": "/healthz" },
    "readinessEndpoint": { "const": "/readyz" },
    "permissions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" } },
    "capabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" } },
    "eventsConsumed": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "\\.v[0-9]+$" } },
    "eventsPublished": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "\\.v[0-9]+$" } }
  },
  "allOf": [
    {
      "if": { "properties": { "key": { "const": "HRMS" } }, "required": ["key"] },
      "then": {
        "properties": {
          "permissions": { "items": { "enum": ["hrms.employees.read", "hrms.employees.manage", "hrms.attendance.self.read", "hrms.attendance.self.write", "hrms.attendance.read", "hrms.attendance.manage", "hrms.devices.self.read", "hrms.devices.self.write", "hrms.devices.read", "hrms.devices.manage", "hrms.leave.self.read", "hrms.leave.self.write", "hrms.leave.approve", "hrms.leave.read", "hrms.leave.manage", "hrms.payroll.read", "hrms.payroll.manage", "hrms.documents.read", "hrms.documents.manage"] } },
          "capabilities": { "items": { "enum": ["HRMS_EMPLOYEES", "HRMS_ORGANIZATION", "HRMS_ATTENDANCE", "HRMS_LEAVE", "HRMS_PAYROLL", "HRMS_DOCUMENTS"] } }
        }
      }
    },
    {
      "if": { "properties": { "key": { "const": "MAIL" } }, "required": ["key"] },
      "then": { "properties": { "permissions": { "maxItems": 0 }, "capabilities": { "maxItems": 0 } } }
    },
    {
      "if": { "properties": { "key": { "const": "POS" } }, "required": ["key"] },
      "then": { "properties": { "permissions": { "maxItems": 0 }, "capabilities": { "maxItems": 0 } } }
    }
  ]
}
