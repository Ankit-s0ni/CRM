{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.blufield.cloud/v1/product-token.schema.json",
  "title": "ProductTokenClaims",
  "type": "object",
  "additionalProperties": false,
  "required": ["sub", "tenantId", "userId", "membershipId", "roles", "products", "capabilities", "permissions", "locale", "entitlementVersion", "iss", "aud", "iat", "exp", "jti"],
  "properties": {
    "sub": { "$ref": "#/$defs/uuid" },
    "tenantId": { "$ref": "#/$defs/uuid" },
    "userId": { "$ref": "#/$defs/uuid" },
    "membershipId": { "$ref": "#/$defs/uuid" },
    "jti": { "$ref": "#/$defs/uuid" },
    "roles": { "type": "array", "items": { "type": "string" } },
    "products": { "type": "array", "items": { "enum": ["HRMS", "MAIL", "POS"] } },
    "capabilities": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" } },
    "permissions": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" } },
    "locale": { "enum": ["en", "ar"] },
    "entitlementVersion": { "type": "integer", "minimum": 0 },
    "iss": { "type": "string", "format": "uri" },
    "aud": { "enum": ["hrms-api", "mail-api", "pos-api"] },
    "iat": { "type": "integer" },
    "exp": { "type": "integer" }
  },
  "$defs": { "uuid": { "type": "string", "format": "uuid" } },
  "allOf": [
    {
      "if": { "properties": { "aud": { "const": "hrms-api" } }, "required": ["aud"] },
      "then": {
        "properties": {
          "products": { "contains": { "const": "HRMS" } },
          "capabilities": { "items": { "enum": ["HRMS_EMPLOYEES", "HRMS_ORGANIZATION", "HRMS_ATTENDANCE", "HRMS_LEAVE", "HRMS_PAYROLL", "HRMS_DOCUMENTS"] } },
          "permissions": { "items": { "enum": ["hrms.employees.read", "hrms.employees.manage", "hrms.attendance.self.read", "hrms.attendance.self.write", "hrms.attendance.read", "hrms.attendance.manage", "hrms.devices.self.read", "hrms.devices.self.write", "hrms.devices.read", "hrms.devices.manage", "hrms.leave.self.read", "hrms.leave.self.write", "hrms.leave.approve", "hrms.leave.read", "hrms.leave.manage", "hrms.payroll.read", "hrms.payroll.manage", "hrms.documents.read", "hrms.documents.manage"] } }
        }
      }
    }
  ]
}
