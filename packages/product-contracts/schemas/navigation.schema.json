{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.blufield.cloud/v1/navigation.schema.json",
  "title": "NavigationContract",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": { "items": { "type": "array", "items": { "$ref": "#/$defs/item" } } },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "hrefTemplate"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "hrefTemplate": { "type": "string", "pattern": "^/\\{locale\\}/app" },
        "requiredProduct": { "enum": ["HRMS", "MAIL", "POS"] },
        "requiredCapability": { "type": "string" },
        "requiredPermission": { "type": "string" }
      }
    }
  }
}
