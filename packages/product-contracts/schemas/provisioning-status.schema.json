{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.blufield.cloud/v1/provisioning-status.schema.json",
  "title": "ProductProvisioningStatus",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenantId", "productKey", "state", "attempt", "updatedAt"],
  "properties": {
    "tenantId": { "type": "string", "format": "uuid" },
    "productKey": { "enum": ["HRMS", "MAIL", "POS"] },
    "state": { "enum": ["NOT_REQUESTED", "PENDING", "PROVISIONING", "ACTIVE", "FAILED", "SUSPENDED"] },
    "attempt": { "type": "integer", "minimum": 0 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "failureCode": { "type": "string" }
  }
}
