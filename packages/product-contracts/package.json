{
  "name": "@deltcrm/product-contracts",
  "version": "1.0.0",
  "description": "Versioned integration contracts between the DeltCRM Platform and product services.",
  "private": false,
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./hrms": {
      "types": "./dist/src/hrms.d.ts",
      "default": "./dist/src/hrms.js"
    },
    "./generated": {
      "types": "./dist/generated/product-integration-client.d.ts",
      "default": "./dist/generated/product-integration-client.js"
    },
    "./schemas/*": "./schemas/*"
  },
  "files": [
    "dist",
    "manifests",
    "openapi",
    "schemas",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node compatibility-tests/validate-contracts.mjs && node compatibility-tests/check-generated-client.mjs",
    "compatibility:check": "node compatibility-tests/check-backward-compatibility.mjs",
    "prepack": "npm run build",
    "pack:check": "node compatibility-tests/verify-package-artifact.mjs"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
