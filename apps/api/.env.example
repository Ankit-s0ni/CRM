DATABASE_URL="postgresql://app_admin:admin_password@localhost:5433/hrms_dev?schema=public"
DATABASE_URL_APP="postgresql://app_user:app_password@localhost:5433/hrms_dev?schema=public"
DATABASE_URL_PLATFORM="postgresql://platform_runtime:platform_password@localhost:5433/hrms_dev?schema=public"

REDIS_URL="redis://localhost:6379"

S3_ENDPOINT="http://localhost:9000"
S3_PUBLIC_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="hrms-uploads"
S3_PRIVATE_BUCKET="hrms-private"
S3_REGION="eu-north-1"
S3_FORCE_PATH_STYLE="true"

NODE_ENV="development"
PORT=4001
PLATFORM_API_PORT=4011
HRMS_API_PORT=4012
CORS_ORIGIN="http://localhost:4002"
# Leave empty for localhost. Production tenant portals use .blufield.cloud so
# browser JavaScript can read only the non-secret CSRF token across subdomains.
AUTH_CSRF_COOKIE_DOMAIN=".your-domain.com"
JWT_SECRET="dev-secret-change-in-production"

# Platform-to-product trust. Production requires a persistent RSA key pair.
# PEM newlines may be stored as literal \n sequences by the secret manager.
PRODUCT_TOKEN_ISSUER="https://auth.blufield.cloud"
PRODUCT_TOKEN_KEY_ID="platform-product-token-v1"
PRODUCT_TOKEN_PRIVATE_KEY="replace-with-pkcs8-private-key"
PRODUCT_TOKEN_PUBLIC_KEY="replace-with-spki-public-key"

# Product service credentials are product-scoped. Keep the current and previous
# keys during a rotation window, then remove the previous key after rollout.
PRODUCT_SERVICE_CREDENTIALS_JSON='{"HRMS":["replace-with-a-random-key-of-at-least-32-characters"]}'

# Transactional email through Mailcow SMTP submission.
MAIL_ENABLED="true"
MAIL_PROVIDER="smtp"
SMTP_HOST="mail.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_REQUIRE_TLS="true"
SMTP_USERNAME="no-reply@example.com"
SMTP_PASSWORD="replace-with-mailcow-app-password"
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="DeltCRM"
MAIL_REPLY_TO="support@example.com"

# Use localhost for local email links. Omit PUBLIC_APP_ORIGIN in production so
# tenant links are generated as https://{workspace}.PUBLIC_BASE_DOMAIN.
PUBLIC_APP_ORIGIN="http://localhost:4002"
PUBLIC_BASE_DOMAIN="blufield.cloud"
