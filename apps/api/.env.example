DATABASE_URL="postgresql://app_admin:admin_password@localhost:5433/hrms_dev?schema=public"
DATABASE_URL_APP="postgresql://app_user:app_password@localhost:5433/hrms_dev?schema=public"
DATABASE_URL_PLATFORM="postgresql://platform_runtime:platform_password@localhost:5433/hrms_dev?schema=public"

REDIS_URL="redis://localhost:6379"

S3_ENDPOINT="http://localhost:9000"
S3_PUBLIC_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_PRIVATE_BUCKET="hrms-private"
S3_REGION="eu-north-1"
S3_FORCE_PATH_STYLE="true"

NODE_ENV="development"
PORT=4001
CORS_ORIGIN="http://localhost:4002"
JWT_SECRET="dev-secret-change-in-production"

# Transactional email through Mailcow SMTP submission.
MAIL_ENABLED="true"
MAIL_PROVIDER="smtp"
SMTP_HOST="mail.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_REQUIRE_TLS="true"
SMTP_USERNAME="no-reply@example.com"
SMTP_PASSWORD="replace-with-mailcow-app-password"
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="DeltCRM"
MAIL_REPLY_TO="support@example.com"

# Use localhost for local email links. Omit PUBLIC_APP_ORIGIN in production so
# tenant links are generated as https://{workspace}.PUBLIC_BASE_DOMAIN.
PUBLIC_APP_ORIGIN="http://localhost:4002"
PUBLIC_BASE_DOMAIN="blufield.cloud"
