{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:generate:platform": "prisma generate --schema=prisma/platform/schema.prisma",
    "prisma:generate:all": "pnpm prisma:generate && pnpm prisma:generate:platform",
    "prisma:seed:platform": "node prisma/platform-seed.js",
    "prisma:migrate:deploy:platform": "prisma migrate deploy --config=prisma.platform.config.ts",
    "prebuild": "pnpm prisma:generate:all",
    "build": "nest build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "prestart": "pnpm prisma:generate:all",
    "start": "nest start --entryFile platform-main",
    "start:dev": "nest start --entryFile platform-main --watch",
    "start:platform:dev": "nest start --entryFile platform-main --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/platform-main",
    "start:platform:prod": "node dist/src/platform-main",
    "start:worker": "ts-node src/platform-worker.ts",
    "start:worker:prod": "node dist/src/platform-worker",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:architecture": "jest src/shared/tests/platform-schema-purity.spec.ts --no-coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "architecture:check": "ts-node scripts/check-architecture.ts",
    "architecture:test": "ts-node scripts/check-architecture.ts --self-test",
    "quality": "pnpm test:architecture && pnpm architecture:test && pnpm typecheck && pnpm lint && pnpm build",
    "openapi:export": "ts-node scripts/export-openapi.ts",
    "ops:observability-drill": "ts-node scripts/observability-drill.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1087.0",
    "@aws-sdk/s3-request-presigner": "^3.1087.0",
    "@casl/ability": "^7.0.1",
    "@casl/prisma": "^2.0.2",
    "@mariya-abdul/deltcrm-product-contracts": "2.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.5",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/client-runtime-utils": "7.8.0",
    "@sentry/node": "^10.66.0",
    "argon2": "^0.44.0",
    "bullmq": "^5.80.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "csv-parse": "^7.0.1",
    "date-holidays": "^3.33.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "ioredis": "^5.11.1",
    "libphonenumber-js": "^1.13.8",
    "luxon": "^3.7.2",
    "nestjs-pino": "^4.6.1",
    "nodemailer": "^7.0.11",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "^7.8.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/luxon": "^3.7.2",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.11",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "pnpm": {
    "allowBuilds": {
      "msgpackr-extract": true
    },
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "@scarf/scarf",
      "argon2",
      "msgpackr-extract",
      "protobufjs",
      "prisma",
      "unrs-resolver"
    ]
  }
}
