// =============================================================================
// schema.prisma — Platform-only (Phase 1 clean track)
//
// OWNERSHIP: DeltCRM Platform team
// RULE: This schema must contain ONLY Platform-owned models and enums.
//       No HRMS tables (Employee, Attendance, Payroll, Leave, Device, etc.)
//       may appear here. HRMS stores Platform IDs (tenantId, userId) as plain
//       String UUID columns with NO Prisma @relation to these tables.
//
// Architecture test: apps/api/src/shared/tests/platform-schema-purity.spec.ts
// =============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/platform-client"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// PLATFORM-OWNED ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CHURNED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum DunningState {
  NONE
  REMINDED
  GRACE
  SUSPEND_PENDING
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

enum PaymentGateway {
  STRIPE
  RAZORPAY
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum WebhookReceiptStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

enum PaymentMethodStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum PaymentMethodType {
  CARD
  BANK_ACCOUNT
  UPI
  WALLET
}

enum DunningAction {
  PAYMENT_FAILED
  REMINDER_SENT
  GRACE_STARTED
  SUSPEND_SCHEDULED
  TENANT_SUSPENDED
  PAYMENT_RECOVERED
  TENANT_REACTIVATED
}

enum DeletionJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  LEGAL_HOLD
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

enum PlatformRole {
  SUPER_ADMIN
  SUPPORT
}

enum LocaleDirection {
  LTR
  RTL
}

enum LocalizationStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum ModuleAvailability {
  AVAILABLE
  COMING_SOON
  DEPRECATED
}

enum ModuleKind {
  PRODUCT
  ADD_ON
}

enum TenantOverrideMode {
  INHERIT
  ENABLE
  DISABLE
}

enum RegisteredProductStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  RETIRED
}

enum ProductManifestRevisionStatus {
  VALIDATED
  ACTIVE
  SUPERSEDED
  REJECTED
}

enum ProductLifecycleMode {
  EVENT
  HTTP
}

enum ProductLimitUnit {
  COUNT
  BYTES
  GIGABYTES
  MINUTES
  REQUESTS
}

enum ProductLimitEnforcement {
  HARD
  SOFT
  METERED
}

enum ProductCapabilityCommercialType {
  CORE
  ADD_ON
}

enum ProductProvisioningState {
  NOT_REQUESTED
  PENDING
  PROVISIONING
  ACTIVE
  FAILED
  SUSPENDED
}

enum ProductDeploymentHealth {
  UNKNOWN
  HEALTHY
  DEGRADED
  UNHEALTHY
  MAINTENANCE
}

enum SystemAlertType {
  PAYMENT_GATEWAY_DOWN
  QUEUE_LAG
  PUSH_FAILURE
  NEW_SUBSCRIPTION
  PLAN_UPGRADED
  TENANT_SUSPENDED
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

enum UserStatus {
  ACTIVE
  LOCKED
  DISABLED
}

enum TokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
  USER_INVITE
  TENANT_SIGNUP
}

enum RevokeReason {
  LOGOUT
  ROTATED
  REUSE_DETECTED
  ADMIN
  PASSWORD_CHANGE
}

enum LoginFailReason {
  BAD_PASSWORD
  LOCKED
  DISABLED
  UNKNOWN_USER
  MFA_FAILED
}

enum NotifChannel {
  PUSH
  EMAIL
  IN_APP
}

enum DeliveryChannel {
  PUSH
  EMAIL
}

enum DeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  BOUNCED
}

// ─────────────────────────────────────────────────────────────────────────────
// TENANCY
// ─────────────────────────────────────────────────────────────────────────────

model Tenant {
  id                        String       @id @default(uuid(7)) @db.Uuid
  companyName               String
  subdomain                 String       @unique
  status                    TenantStatus @default(TRIAL)
  companyLogo               String?
  suspendedAt               DateTime?
  suspendedReason           String?
  suspendedByPlatformUserId String?      @db.Uuid
  onboardingIdempotencyKey  String?      @unique
  onboardingRequestHash     String?
  onboardingCompletedAt     DateTime?
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt

  settings             TenantSettings?
  localePolicy         TenantLocalePolicy?
  translationOverrides TenantTranslationOverride[]
  billingProfile       TenantBillingProfile?
  subscriptions        TenantSubscription[]
  invoices             TenantInvoice[]
  paymentMethods       BillingPaymentMethod[]
  deletionJobs         TenantDeletionJob[]
  users                User[]

  @@index([status, createdAt])
  @@map("tenants")
}

// ─────────────────────────────────────────────────────────────────────────────
// TENANT SETTINGS & LOCALIZATION
// ─────────────────────────────────────────────────────────────────────────────

model TenantSettings {
  tenantId                 String   @id @db.Uuid
  timezone                 String   @default("Asia/Kolkata")
  locale                   String   @default("en")
  weeklyOffs               Json     @default("[\"SAT\",\"SUN\"]")
  requireFacialRecognition Boolean  @default(false)
  faceMatchThreshold       Int      @default(85)
  fieldTrackingEnabled     Boolean  @default(false)
  fieldTrackingIntervalMin Int      @default(15)
  runtimeConfigVersion     Int      @default(1)
  checkinReminderEnabled   Boolean  @default(true)
  checkoutReminderMinutes  Int      @default(15)
  regularizationWindowDays Int      @default(7)
  absenteeAlertTime        String   @default("10:00")
  companyLogoKey           String?
  workingDayStart          String   @default("09:00")
  workingDayEnd            String   @default("18:00")
  onboardingStep           Int      @default(1)
  onboardingVersion        Int      @default(1)
  updatedAt                DateTime @updatedAt
  tenant                   Tenant   @relation(fields: [tenantId], references: [id])

  @@map("tenant_settings")
}

model TenantLocalePolicy {
  tenantId               String   @id @db.Uuid
  defaultLocale          String   @default("en")
  regionalLocale         String   @default("ar")
  regionalOverrideReason String?
  enabledLocales         String[] @default(["en"])
  allowUserPreference    Boolean  @default(false)
  allowTenantOverrides   Boolean  @default(false)
  catalogVersion         Int      @default(1)
  updatedBy              String?  @db.Uuid
  updatedAt              DateTime @updatedAt
  tenant                 Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_locale_policies")
}

model TenantTranslationOverride {
  id          String             @id @default(uuid(7)) @db.Uuid
  tenantId    String             @db.Uuid
  locale      String
  keyId       String             @db.Uuid
  value       String
  status      LocalizationStatus @default(DRAFT)
  reason      String
  version     Int                @default(1)
  publishedBy String?            @db.Uuid
  publishedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key         LocalizationKey    @relation(fields: [keyId], references: [id], onDelete: Cascade)

  @@unique([tenantId, locale, keyId, version])
  @@index([tenantId, locale, status])
  @@map("tenant_translation_overrides")
}

// ─────────────────────────────────────────────────────────────────────────────
// LOCALIZATION CATALOG
// ─────────────────────────────────────────────────────────────────────────────

model LocalePack {
  id           String              @id @default(uuid(7)) @db.Uuid
  locale       String
  parentLocale String?
  displayName  String
  nativeName   String
  direction    LocaleDirection
  status       LocalizationStatus  @default(DRAFT)
  version      Int                 @default(1)
  publishedAt  DateTime?
  publishedBy  String?             @db.Uuid
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  translations LocaleTranslation[]

  @@unique([locale, version])
  @@index([locale, status, version])
  @@map("locale_packs")
}

model LocalizationKey {
  id                String                      @id @default(uuid(7)) @db.Uuid
  key               String                      @unique
  namespace         String
  defaultMessage    String
  description       String?
  placeholderSchema Json                        @default("{}")
  isTenantEditable  Boolean                     @default(false)
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  translations      LocaleTranslation[]
  tenantOverrides   TenantTranslationOverride[]

  @@index([namespace, key])
  @@map("localization_keys")
}

model LocaleTranslation {
  localePackId String             @db.Uuid
  keyId        String             @db.Uuid
  value        String
  status       LocalizationStatus @default(DRAFT)
  reviewedBy   String?            @db.Uuid
  reviewedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  localePack   LocalePack         @relation(fields: [localePackId], references: [id], onDelete: Cascade)
  key          LocalizationKey    @relation(fields: [keyId], references: [id], onDelete: Cascade)

  @@id([localePackId, keyId])
  @@index([keyId, status])
  @@map("locale_translations")
}

// ─────────────────────────────────────────────────────────────────────────────
// BILLING & SUBSCRIPTIONS
// ─────────────────────────────────────────────────────────────────────────────

model TenantBillingProfile {
  tenantId     String   @id @db.Uuid
  legalName    String
  billingEmail String
  address      Json?
  gstin        String?
  pan          String?
  currency     String   @default("OMR")
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  @@map("tenant_billing_profiles")
}

model SubscriptionPlan {
  id                      String                       @id @default(uuid(7)) @db.Uuid
  name                    String                       @unique
  pricePerUser            Decimal                      @db.Decimal(10, 2)
  currency                String                       @default("OMR")
  maxEmployees            Int
  billingPeriod           BillingPeriod                @default(MONTHLY)
  description             String?
  isActive                Boolean                      @default(true)
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  subscriptions           TenantSubscription[]
  modules                 SubscriptionPlanModule[]
  capabilities            SubscriptionPlanCapability[]
  history                 TenantSubscriptionHistory[]
  productGrants           PlanProductGrant[]
  productCapabilityGrants PlanProductCapabilityGrant[]
  productLimitGrants      PlanProductLimitGrant[]

  @@map("subscription_plans")
}

// ─────────────────────────────────────────────────────────────────────────────
// DYNAMIC PRODUCT REGISTRY (legacy Module models below are migration-only)
// ─────────────────────────────────────────────────────────────────────────────

model RegisteredProduct {
  id                        String                              @id @default(uuid(7)) @db.Uuid
  productKey                String                              @unique
  audience                  String                              @unique
  webPath                   String                              @unique
  apiPrefix                 String                              @unique
  displayName               String
  description               String
  status                    RegisteredProductStatus             @default(DRAFT)
  activeRevisionId          String?                             @unique @db.Uuid
  version                   Int                                 @default(1)
  createdBy                 String?                             @db.Uuid
  createdAt                 DateTime                            @default(now())
  updatedAt                 DateTime                            @updatedAt
  activeRevision            ProductManifestRevision?            @relation("ActiveProductRevision", fields: [activeRevisionId], references: [id])
  revisions                 ProductManifestRevision[]           @relation("ProductRevisions")
  permissions               ProductPermissionDefinition[]
  capabilities              ProductCapabilityDefinition[]
  limits                    ProductLimitDefinition[]
  events                    ProductEventDefinition[]
  deployments               ProductDeployment[]
  credentials               ProductServiceCredential[]
  planGrants                PlanProductGrant[]
  planCapabilityGrants      PlanProductCapabilityGrant[]
  planLimitGrants           PlanProductLimitGrant[]
  tenantOverrides           TenantProductOverride[]
  tenantCapabilityOverrides TenantProductCapabilityOverride[]
  tenantLimitOverrides      TenantProductLimitOverride[]
  effectiveEntitlements     EffectiveTenantProductEntitlement[]
  provisioning              ProductProvisioningInstance[]
  lifecycleDeliveries       ProductLifecycleDelivery[]
  usageSnapshots            ProductUsageSnapshot[]

  @@index([status, displayName])
  @@map("registered_products")
}

model ProductManifestRevision {
  id                     String                        @id @default(uuid(7)) @db.Uuid
  productId              String                        @db.Uuid
  manifestVersion        String
  schemaVersion          Int
  minimumContractVersion String?
  manifest               Json
  contentHash            String
  signature              String?
  signingKeyId           String?
  status                 ProductManifestRevisionStatus @default(VALIDATED)
  validationResult       Json
  registeredBy           String?                       @db.Uuid
  registeredAt           DateTime                      @default(now())
  activatedAt            DateTime?
  idempotencyKey         String?                       @unique
  version                Int                           @default(1)
  product                RegisteredProduct             @relation("ProductRevisions", fields: [productId], references: [id], onDelete: Cascade)
  activeFor              RegisteredProduct?            @relation("ActiveProductRevision")

  @@unique([productId, manifestVersion])
  @@unique([productId, contentHash])
  @@index([productId, status, registeredAt])
  @@map("product_manifest_revisions")
}

model ProductPermissionDefinition {
  id                              String            @id @default(uuid(7)) @db.Uuid
  productId                       String            @db.Uuid
  key                             String            @unique
  description                     String
  platformPermissionAliases       String[]          @default([])
  platformPermissionPrefixAliases String[]          @default([])
  requiredCapabilityKeys          String[]          @default([])
  deprecated                      Boolean           @default(false)
  createdAt                       DateTime          @default(now())
  updatedAt                       DateTime          @updatedAt
  product                         RegisteredProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, deprecated])
  @@map("product_permission_definitions")
}

model ProductCapabilityDefinition {
  id              String                            @id @default(uuid(7)) @db.Uuid
  productId       String                            @db.Uuid
  key             String                            @unique
  description     String
  required        Boolean                           @default(false)
  commercialType  ProductCapabilityCommercialType  @default(CORE)
  dependencyKeys  String[]                          @default([])
  conflictKeys    String[]                          @default([])
  deprecated      Boolean                           @default(false)
  createdAt       DateTime                          @default(now())
  updatedAt       DateTime                          @updatedAt
  product         RegisteredProduct                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  planGrants      PlanProductCapabilityGrant[]
  tenantOverrides TenantProductCapabilityOverride[]

  @@index([productId, deprecated])
  @@map("product_capability_definitions")
}

model ProductLimitDefinition {
  id              String                       @id @default(uuid(7)) @db.Uuid
  productId       String                       @db.Uuid
  key             String                       @unique
  description     String?
  unit            ProductLimitUnit
  enforcement     ProductLimitEnforcement
  deprecated      Boolean                      @default(false)
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  product         RegisteredProduct            @relation(fields: [productId], references: [id], onDelete: Cascade)
  planGrants      PlanProductLimitGrant[]
  tenantOverrides TenantProductLimitOverride[]

  @@index([productId, deprecated])
  @@map("product_limit_definitions")
}

model ProductEventDefinition {
  id        String            @id @default(uuid(7)) @db.Uuid
  productId String            @db.Uuid
  eventKey  String
  direction String
  createdAt DateTime          @default(now())
  product   RegisteredProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, eventKey, direction])
  @@map("product_event_definitions")
}

model ProductDeployment {
  id                 String                  @id @default(uuid(7)) @db.Uuid
  productId          String                  @db.Uuid
  environment        String
  internalApiBaseUrl String
  internalWebBaseUrl String?
  region             String?
  maintenance        Boolean                 @default(false)
  health             ProductDeploymentHealth @default(UNKNOWN)
  lastHealthCheckAt  DateTime?
  lastHealthMessage  String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  version            Int                     @default(1)
  product            RegisteredProduct       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, environment])
  @@index([environment, health])
  @@map("product_deployments")
}

model ProductServiceCredential {
  id            String            @id @default(uuid(7)) @db.Uuid
  productId     String            @db.Uuid
  environment   String
  keyId         String
  secretRef     String
  state         String            @default("ACTIVE")
  rotatedFromId String?           @db.Uuid
  activatedAt   DateTime          @default(now())
  expiresAt     DateTime?
  revokedAt     DateTime?
  createdBy     String?           @db.Uuid
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  product       RegisteredProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, environment, keyId])
  @@index([productId, environment, state])
  @@index([expiresAt])
  @@map("product_service_credentials")
}

model PlanProductGrant {
  planId    String            @db.Uuid
  productId String            @db.Uuid
  included  Boolean           @default(true)
  plan      SubscriptionPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  product   RegisteredProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([planId, productId])
  @@map("plan_product_grants")
}

model PlanProductCapabilityGrant {
  planId       String                      @db.Uuid
  productId    String                      @db.Uuid
  capabilityId String                      @db.Uuid
  included     Boolean                     @default(true)
  plan         SubscriptionPlan            @relation(fields: [planId], references: [id], onDelete: Cascade)
  product      RegisteredProduct           @relation(fields: [productId], references: [id], onDelete: Cascade)
  capability   ProductCapabilityDefinition @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@id([planId, capabilityId])
  @@index([productId])
  @@map("plan_product_capability_grants")
}

model PlanProductLimitGrant {
  planId    String                 @db.Uuid
  productId String                 @db.Uuid
  limitId   String                 @db.Uuid
  value     Decimal                @db.Decimal(20, 4)
  plan      SubscriptionPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  product   RegisteredProduct      @relation(fields: [productId], references: [id], onDelete: Cascade)
  limit     ProductLimitDefinition @relation(fields: [limitId], references: [id], onDelete: Cascade)

  @@id([planId, limitId])
  @@index([productId])
  @@map("plan_product_limit_grants")
}

model TenantProductOverride {
  id        String             @id @default(uuid(7)) @db.Uuid
  tenantId  String             @db.Uuid
  productId String             @db.Uuid
  mode      TenantOverrideMode
  reason    String
  startsAt  DateTime?
  endsAt    DateTime?
  changedBy String             @db.Uuid
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  version   Int                @default(1)
  product   RegisteredProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([tenantId, productId])
  @@index([tenantId, mode])
  @@index([endsAt])
  @@map("tenant_product_overrides")
}

model TenantProductCapabilityOverride {
  id           String                      @id @default(uuid(7)) @db.Uuid
  tenantId     String                      @db.Uuid
  productId    String                      @db.Uuid
  capabilityId String                      @db.Uuid
  mode         TenantOverrideMode
  reason       String
  startsAt     DateTime?
  endsAt       DateTime?
  changedBy    String                      @db.Uuid
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
  version      Int                         @default(1)
  product      RegisteredProduct           @relation(fields: [productId], references: [id], onDelete: Cascade)
  capability   ProductCapabilityDefinition @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@unique([tenantId, capabilityId])
  @@index([tenantId, productId, mode])
  @@index([endsAt])
  @@map("tenant_product_capability_overrides")
}

model TenantProductLimitOverride {
  id        String                 @id @default(uuid(7)) @db.Uuid
  tenantId  String                 @db.Uuid
  productId String                 @db.Uuid
  limitId   String                 @db.Uuid
  value     Decimal                @db.Decimal(20, 4)
  reason    String
  startsAt  DateTime?
  endsAt    DateTime?
  changedBy String                 @db.Uuid
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  version   Int                    @default(1)
  product   RegisteredProduct      @relation(fields: [productId], references: [id], onDelete: Cascade)
  limit     ProductLimitDefinition @relation(fields: [limitId], references: [id], onDelete: Cascade)

  @@unique([tenantId, limitId])
  @@index([tenantId, productId])
  @@index([endsAt])
  @@map("tenant_product_limit_overrides")
}

model EffectiveTenantProductEntitlement {
  id                 String            @id @default(uuid(7)) @db.Uuid
  tenantId           String            @db.Uuid
  productId          String            @db.Uuid
  active             Boolean
  capabilities       Json
  limits             Json
  source             Json
  entitlementVersion Int
  effectiveAt        DateTime          @default(now())
  projectionVersion  Int               @default(1)
  product            RegisteredProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([tenantId, productId])
  @@index([tenantId, entitlementVersion])
  @@map("effective_tenant_product_entitlements")
}

model ProductProvisioningInstance {
  id          String                   @id @default(uuid(7)) @db.Uuid
  tenantId    String                   @db.Uuid
  productId   String                   @db.Uuid
  state       ProductProvisioningState @default(NOT_REQUESTED)
  attempt     Int                      @default(0)
  failureCode String?
  lastEventId String?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  version     Int                      @default(1)
  product     RegisteredProduct        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([tenantId, productId])
  @@index([state, updatedAt])
  @@map("product_provisioning_instances")
}

model ProductLifecycleDelivery {
  id             String            @id @default(uuid(7)) @db.Uuid
  tenantId       String            @db.Uuid
  productId      String            @db.Uuid
  eventId        String            @unique @db.Uuid
  eventKey       String
  idempotencyKey String            @unique
  correlationId  String            @db.Uuid
  attemptCount   Int               @default(0)
  publishedAt    DateTime?
  acknowledgedAt DateTime?
  deadLetteredAt DateTime?
  lastError      String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  product        RegisteredProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId, productId, createdAt])
  @@index([publishedAt, deadLetteredAt])
  @@map("product_lifecycle_deliveries")
}

model ProductUsageSnapshot {
  id                 String            @id @default(uuid(7)) @db.Uuid
  tenantId           String            @db.Uuid
  productId          String            @db.Uuid
  metricKey          String
  value              Decimal           @db.Decimal(20, 4)
  entitlementVersion Int
  sourceEventId      String            @unique
  occurredAt         DateTime
  createdAt          DateTime          @default(now())
  product            RegisteredProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId, productId, metricKey, occurredAt])
  @@map("product_usage_snapshots")
}

model ProductRegistryMigrationLedger {
  id             String   @id @default(uuid(7)) @db.Uuid
  migrationKey   String
  sourceRecordId String
  targetRecordId String?
  sourceSnapshot Json
  resultSnapshot Json?
  status         String
  error          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([migrationKey, sourceRecordId])
  @@index([migrationKey, status])
  @@map("product_registry_migration_ledger")
}

model SubscriptionPlanModule {
  planId   String           @db.Uuid
  moduleId String           @db.Uuid
  plan     SubscriptionPlan @relation(fields: [planId], references: [id])
  module   Module           @relation(fields: [moduleId], references: [id])

  @@id([planId, moduleId])
  @@map("subscription_plan_modules")
}

model TenantSubscription {
  id                      String                      @id @default(uuid(7)) @db.Uuid
  tenantId                String                      @db.Uuid
  planId                  String                      @db.Uuid
  status                  SubscriptionStatus          @default(TRIALING)
  seatCount               Int
  currentPeriodStart      DateTime                    @db.Date
  currentPeriodEnd        DateTime                    @db.Date
  dunningState            DunningState                @default(NONE)
  provider                PaymentGateway?
  providerCustomerRef     String?
  providerSubscriptionRef String?
  cancelAtPeriodEnd       Boolean                     @default(false)
  pendingPlanId           String?                     @db.Uuid
  scheduledChangeAt       DateTime?
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  tenant                  Tenant                      @relation(fields: [tenantId], references: [id])
  plan                    SubscriptionPlan            @relation(fields: [planId], references: [id])
  invoices                TenantInvoice[]
  history                 TenantSubscriptionHistory[]
  dunningHistory          DunningTransition[]

  @@index([tenantId, status])
  @@map("tenant_subscriptions")
}

model TenantSubscriptionHistory {
  id                  String             @id @default(uuid(7)) @db.Uuid
  tenantId            String             @db.Uuid
  subscriptionId      String             @db.Uuid
  planId              String             @db.Uuid
  status              SubscriptionStatus
  seatCount           Int
  reason              String
  actorUserId         String?            @db.Uuid
  actorPlatformUserId String?            @db.Uuid
  sourceEventId       String?
  snapshot            Json
  createdAt           DateTime           @default(now())
  subscription        TenantSubscription @relation(fields: [subscriptionId], references: [id])
  plan                SubscriptionPlan   @relation(fields: [planId], references: [id])

  @@unique([tenantId, sourceEventId])
  @@index([tenantId, subscriptionId, createdAt])
  @@map("tenant_subscription_history")
}

model Module {
  id                String                   @id @default(uuid(7)) @db.Uuid
  key               String                   @unique
  name              String
  description       String?
  icon              String?
  availability      ModuleAvailability       @default(AVAILABLE)
  kind              ModuleKind               @default(PRODUCT)
  parentModuleId    String?                  @db.Uuid
  catalogOrder      Int                      @default(0)
  customerVisible   Boolean                  @default(true)
  dependencyKeys    String[]                 @default([])
  conflictKeys      String[]                 @default([])
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  tenantModules     TenantModule[]
  subscriptionPlans SubscriptionPlanModule[]
  parentModule      Module?                  @relation("ModuleAddOns", fields: [parentModuleId], references: [id])
  addOns            Module[]                 @relation("ModuleAddOns")
  capabilities      ModuleCapability[]

  @@index([kind, availability, catalogOrder])
  @@index([parentModuleId])
  @@map("modules")
}

model ModuleCapability {
  id                 String                       @id @default(uuid(7)) @db.Uuid
  moduleId           String                       @db.Uuid
  key                String                       @unique
  name               String
  description        String?
  availability       ModuleAvailability           @default(AVAILABLE)
  isCore             Boolean                      @default(false)
  configurable       Boolean                      @default(true)
  requiredModuleKeys String[]                     @default([])
  dependencyKeys     String[]                     @default([])
  conflictKeys       String[]                     @default([])
  displayOrder       Int                          @default(0)
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  module             Module                       @relation(fields: [moduleId], references: [id])
  subscriptionPlans  SubscriptionPlanCapability[]
  tenantOverrides    TenantCapabilityOverride[]

  @@index([moduleId, availability, displayOrder])
  @@map("module_capabilities")
}

model SubscriptionPlanCapability {
  planId       String           @db.Uuid
  capabilityId String           @db.Uuid
  included     Boolean          @default(true)
  limitValue   Json?
  plan         SubscriptionPlan @relation(fields: [planId], references: [id])
  capability   ModuleCapability @relation(fields: [capabilityId], references: [id])

  @@id([planId, capabilityId])
  @@map("subscription_plan_capabilities")
}

model TenantCapabilityOverride {
  id           String             @id @default(uuid(7)) @db.Uuid
  tenantId     String             @db.Uuid
  capabilityId String             @db.Uuid
  mode         TenantOverrideMode
  limitValue   Json?
  reason       String
  startsAt     DateTime?
  endsAt       DateTime?
  changedBy    String             @db.Uuid
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  capability   ModuleCapability   @relation(fields: [capabilityId], references: [id])

  @@unique([tenantId, capabilityId])
  @@index([tenantId, mode])
  @@index([endsAt])
  @@map("tenant_capability_overrides")
}

model TenantModule {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @db.Uuid
  moduleId    String    @db.Uuid
  isActive    Boolean   @default(false)
  activatedAt DateTime?
  activatedBy String?   @db.Uuid
  module      Module    @relation(fields: [moduleId], references: [id])

  @@unique([tenantId, moduleId])
  @@map("tenant_modules")
}

model TenantInvoice {
  id              String                  @id @default(uuid(7)) @db.Uuid
  tenantId        String                  @db.Uuid
  subscriptionId  String                  @db.Uuid
  invoiceNumber   String                  @unique
  fiscalYear      String
  sequenceNumber  Int
  subtotalAmount  Decimal                 @default(0) @db.Decimal(12, 2)
  amountDue       Decimal                 @db.Decimal(12, 2)
  taxAmount       Decimal                 @default(0) @db.Decimal(12, 2)
  cgstAmount      Decimal                 @default(0) @db.Decimal(12, 2)
  sgstAmount      Decimal                 @default(0) @db.Decimal(12, 2)
  igstAmount      Decimal                 @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal                 @db.Decimal(12, 2)
  currency        String                  @default("OMR")
  dueDate         DateTime                @db.Date
  status          InvoiceStatus           @default(DRAFT)
  pdfUrl          String?
  objectKey       String?
  pdfChecksum     String?
  billingSnapshot Json
  taxSnapshot     Json
  issuedAt        DateTime?
  paidAt          DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  tenant          Tenant                  @relation(fields: [tenantId], references: [id])
  subscription    TenantSubscription      @relation(fields: [subscriptionId], references: [id])
  transactions    PaymentTransaction[]
  lineItems       TenantInvoiceLineItem[]

  @@unique([fiscalYear, sequenceNumber])
  @@index([tenantId, status])
  @@map("tenant_invoices")
}

model TenantInvoiceLineItem {
  id          String        @id @default(uuid(7)) @db.Uuid
  tenantId    String        @db.Uuid
  invoiceId   String        @db.Uuid
  description String
  quantity    Decimal       @db.Decimal(12, 3)
  unitAmount  Decimal       @db.Decimal(12, 2)
  amount      Decimal       @db.Decimal(12, 2)
  taxRate     Decimal       @default(0) @db.Decimal(5, 2)
  metadata    Json?
  invoice     TenantInvoice @relation(fields: [invoiceId], references: [id])

  @@index([tenantId, invoiceId])
  @@map("tenant_invoice_line_items")
}

model InvoiceSequence {
  fiscalYear String   @id
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@map("invoice_sequences")
}

model PaymentTransaction {
  id              String         @id @default(uuid(7)) @db.Uuid
  tenantId        String         @db.Uuid
  invoiceId       String         @db.Uuid
  gateway         PaymentGateway
  gatewayRef      String?
  amount          Decimal        @db.Decimal(12, 2)
  currency        String         @default("OMR")
  status          PaymentStatus  @default(PENDING)
  failureReason   String?
  providerEventId String?
  idempotencyKey  String?
  metadata        Json?
  attemptedAt     DateTime       @default(now())
  invoice         TenantInvoice  @relation(fields: [invoiceId], references: [id])

  @@unique([gateway, gatewayRef])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, invoiceId, attemptedAt])
  @@map("payment_transactions")
}

model BillingPaymentMethod {
  id                String              @id @default(uuid(7)) @db.Uuid
  tenantId          String              @db.Uuid
  gateway           PaymentGateway
  providerMethodRef String
  methodType        PaymentMethodType
  displayName       String
  lastFour          String?
  expiryMonth       Int?
  expiryYear        Int?
  isDefault         Boolean             @default(false)
  status            PaymentMethodStatus @default(ACTIVE)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  tenant            Tenant              @relation(fields: [tenantId], references: [id])

  @@unique([gateway, providerMethodRef])
  @@index([tenantId, status])
  @@map("billing_payment_methods")
}

model BillingWebhookReceipt {
  id              String               @id @default(uuid(7)) @db.Uuid
  provider        PaymentGateway
  providerEventId String
  eventType       String
  occurredAt      DateTime
  payloadHash     String
  status          WebhookReceiptStatus @default(RECEIVED)
  attemptCount    Int                  @default(0)
  normalizedEvent Json?
  outcome         Json?
  failureCode     String?
  processedAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([provider, providerEventId])
  @@index([status, createdAt])
  @@map("billing_webhook_receipts")
}

model DunningTransition {
  id             String             @id @default(uuid(7)) @db.Uuid
  tenantId       String             @db.Uuid
  subscriptionId String             @db.Uuid
  action         DunningAction
  fromState      DunningState
  toState        DunningState
  idempotencyKey String
  reason         String
  scheduledFor   DateTime?
  completedAt    DateTime?
  metadata       Json?
  createdAt      DateTime           @default(now())
  subscription   TenantSubscription @relation(fields: [subscriptionId], references: [id])

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, subscriptionId, createdAt])
  @@index([scheduledFor, completedAt])
  @@map("dunning_transitions")
}

model TenantDeletionJob {
  id                String            @id @default(uuid(7)) @db.Uuid
  tenantId          String            @db.Uuid
  status            DeletionJobStatus @default(PENDING)
  requestedBy       String?           @db.Uuid
  reason            String
  legalHoldUntil    DateTime?
  biometricPurgedAt DateTime?
  completedAt       DateTime?
  failureCode       String?
  evidence          Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  tenant            Tenant            @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status])
  @@map("tenant_deletion_jobs")
}

// ─────────────────────────────────────────────────────────────────────────────
// PLATFORM SUPER-ADMIN IDENTITY
// ─────────────────────────────────────────────────────────────────────────────

model PlatformUser {
  id                String                    @id @default(uuid(7)) @db.Uuid
  email             String                    @unique
  passwordHash      String
  role              PlatformRole
  mfaSecret         String?
  mfaEnabled        Boolean                   @default(false)
  failedLoginCount  Int                       @default(0)
  lockedUntil       DateTime?
  passwordChangedAt DateTime?
  lastLoginAt       DateTime?
  lastLoginIp       String?
  status            UserStatus                @default(ACTIVE)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  impersonations    ImpersonationSession[]
  authChallenges    PlatformAuthChallenge[]
  sessions          PlatformSession[]
  recoveryCodes     PlatformMfaRecoveryCode[]

  @@map("platform_users")
}

model PlatformAuthChallenge {
  id             String       @id @default(uuid(7)) @db.Uuid
  platformUserId String       @db.Uuid
  tokenHash      String       @unique
  attemptCount   Int          @default(0)
  expiresAt      DateTime
  consumedAt     DateTime?
  createdIp      String?
  userAgent      String?
  createdAt      DateTime     @default(now())
  platformUser   PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)

  @@index([platformUserId, expiresAt])
  @@map("platform_auth_challenges")
}

model PlatformSession {
  id             String                 @id @default(uuid(7)) @db.Uuid
  platformUserId String                 @db.Uuid
  mfaVerifiedAt  DateTime
  expiresAt      DateTime
  revokedAt      DateTime?
  createdIp      String?
  userAgent      String?
  createdAt      DateTime               @default(now())
  lastSeenAt     DateTime               @default(now())
  platformUser   PlatformUser           @relation(fields: [platformUserId], references: [id], onDelete: Cascade)
  refreshTokens  PlatformRefreshToken[]
  impersonations ImpersonationSession[]

  @@index([platformUserId, revokedAt, expiresAt])
  @@map("platform_sessions")
}

model PlatformRefreshToken {
  id            String          @id @default(uuid(7)) @db.Uuid
  sessionId     String          @db.Uuid
  tokenHash     String          @unique
  familyId      String          @db.Uuid
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason RevokeReason?
  createdIp     String?
  userAgent     String?
  createdAt     DateTime        @default(now())
  session       PlatformSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, familyId, revokedAt])
  @@map("platform_refresh_tokens")
}

model PlatformMfaRecoveryCode {
  id             String       @id @default(uuid(7)) @db.Uuid
  platformUserId String       @db.Uuid
  codeHash       String       @unique
  usedAt         DateTime?
  createdAt      DateTime     @default(now())
  platformUser   PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)

  @@index([platformUserId, usedAt])
  @@map("platform_mfa_recovery_codes")
}

model PlatformPermission {
  id              String                   @id @default(uuid(7)) @db.Uuid
  key             String                   @unique
  rolePermissions PlatformRolePermission[]

  @@map("platform_permissions")
}

model PlatformRolePermission {
  role         PlatformRole
  permissionId String             @db.Uuid
  permission   PlatformPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([role, permissionId])
  @@map("platform_role_permissions")
}

model ImpersonationSession {
  id                    String          @id @default(uuid(7)) @db.Uuid
  platformUserId        String          @db.Uuid
  platformSessionId     String          @db.Uuid
  tenantId              String          @db.Uuid
  targetUserId          String          @db.Uuid
  tokenJti              String          @unique @db.Uuid
  scopes                String[]        @default([])
  reason                String
  startedAt             DateTime        @default(now())
  endedAt               DateTime?
  endedReason           String?
  endedByPlatformUserId String?         @db.Uuid
  expiresAt             DateTime
  ipAddress             String?
  userAgent             String?
  platformUser          PlatformUser    @relation(fields: [platformUserId], references: [id])
  platformSession       PlatformSession @relation(fields: [platformSessionId], references: [id], onDelete: Cascade)

  @@index([tenantId, startedAt])
  @@index([platformUserId, endedAt, expiresAt])
  @@index([targetUserId, endedAt, expiresAt])
  @@map("impersonation_sessions")
}

// ─────────────────────────────────────────────────────────────────────────────
// SYSTEM HEALTH & AUDIT
// ─────────────────────────────────────────────────────────────────────────────

model SystemAlert {
  id               String          @id @default(uuid(7)) @db.Uuid
  alertType        SystemAlertType
  severity         AlertSeverity
  title            String
  payload          Json?
  tenantId         String?         @db.Uuid
  status           AlertStatus     @default(OPEN)
  acknowledgedBy   String?         @db.Uuid
  acknowledgedAt   DateTime?
  acknowledgedNote String?
  resolvedBy       String?         @db.Uuid
  resolvedAt       DateTime?
  resolvedNote     String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([status, severity, createdAt])
  @@map("system_alerts")
}

model SystemAuditLog {
  id                     String   @id @default(uuid(7)) @db.Uuid
  actorPlatformUserId    String?  @db.Uuid
  impersonationSessionId String?  @db.Uuid
  tenantId               String?  @db.Uuid
  action                 String
  module                 String
  oldValue               Json?
  newValue               Json?
  ipAddress              String?
  userAgent              String?
  requestId              String?
  createdAt              DateTime @default(now())

  @@index([actorPlatformUserId, createdAt])
  @@index([tenantId, createdAt])
  @@index([module, createdAt])
  @@index([action, createdAt])
  @@map("system_audit_logs")
}

/// Tenant-visible, append-only audit history for workspace administration.
/// This belongs to the Platform database; product business audit data remains
/// inside each product database.
model TenantAuditLog {
  id                     String   @id @default(uuid(7)) @db.Uuid
  tenantId               String   @db.Uuid
  actorUserId            String?  @db.Uuid
  impersonationSessionId String?  @db.Uuid
  action                 String
  module                 String
  entityType             String?
  entityId               String?  @db.Uuid
  oldValue               Json?
  newValue               Json?
  ipAddress              String?
  userAgent              String?
  requestId              String?
  createdAt              DateTime @default(now())

  @@index([tenantId, module, createdAt])
  @@index([tenantId, entityType, entityId])
  @@map("tenant_audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// TENANT WORKSPACE IDENTITY & ACCESS
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id                      String                   @id @default(uuid(7)) @db.Uuid
  tenantId                String                   @db.Uuid
  email                   String
  phone                   String?
  passwordHash            String
  status                  UserStatus               @default(ACTIVE)
  emailVerifiedAt         DateTime?
  passwordChangedAt       DateTime?
  failedLoginCount        Int                      @default(0)
  lockedUntil             DateTime?
  lastLoginAt             DateTime?
  lastLoginIp             String?
  mfaSecret               String?
  mfaEnabled              Boolean                  @default(false)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  tenant                  Tenant                   @relation(fields: [tenantId], references: [id])
  roles                   UserRole[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]

  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@map("users")
}

model VerificationToken {
  id         String       @id @default(uuid(7)) @db.Uuid
  tenantId   String?      @db.Uuid
  userId     String?      @db.Uuid
  email      String
  purpose    TokenPurpose
  tokenHash  String
  payload    Json?
  expiresAt  DateTime
  consumedAt DateTime?
  createdIp  String?
  invitedBy  String?      @db.Uuid
  createdAt  DateTime     @default(now())

  @@index([email, purpose])
  @@index([tokenHash])
  @@map("verification_tokens")
}

model Role {
  id          String           @id @default(uuid(7)) @db.Uuid
  tenantId    String?          @db.Uuid
  name        String
  isSystem    Boolean          @default(false)
  permissions RolePermission[]
  users       UserRole[]

  @@unique([tenantId, name])
  @@map("roles")
}

model Permission {
  id    String           @id @default(uuid(7)) @db.Uuid
  key   String           @unique
  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id            String        @id @default(uuid(7)) @db.Uuid
  userId        String        @db.Uuid
  tokenHash     String
  familyId      String        @db.Uuid
  deviceId      String?       @db.Uuid
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason RevokeReason?
  createdIp     String?
  userAgent     String?
  createdAt     DateTime      @default(now())

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model LoginAttempt {
  id            String           @id @default(uuid(7)) @db.Uuid
  tenantId      String?          @db.Uuid
  email         String
  ipAddress     String
  userAgent     String?
  success       Boolean
  failureReason LoginFailReason?
  createdAt     DateTime         @default(now())

  @@index([tenantId, email, createdAt])
  @@map("login_attempts")
}

// ─────────────────────────────────────────────────────────────────────────────
// NOTIFICATIONS (Platform-owned; HRMS sends events via contract to trigger these)
// ─────────────────────────────────────────────────────────────────────────────

model NotificationTemplate {
  id                String       @id @default(uuid(7)) @db.Uuid
  eventKey          String
  channel           NotifChannel
  locale            String       @default("en")
  subject           String?
  bodyTemplate      String
  requiredVariables Json         @default("[]")
  version           Int          @default(1)
  isActive          Boolean      @default(true)

  @@unique([eventKey, channel, locale])
  @@map("notification_templates")
}

model NotificationPreference {
  id       String       @id @default(uuid(7)) @db.Uuid
  tenantId String       @db.Uuid
  userId   String       @db.Uuid
  eventKey String
  channel  NotifChannel
  enabled  Boolean      @default(true)
  user     User         @relation(fields: [userId], references: [id])

  @@unique([tenantId, userId, eventKey, channel])
  @@map("notification_preferences")
}

model Notification {
  id            String                 @id @default(uuid(7)) @db.Uuid
  tenantId      String                 @db.Uuid
  userId        String                 @db.Uuid
  eventKey      String
  dedupeKey     String
  severity      AlertSeverity          @default(INFO)
  title         String
  body          String
  module        String?
  referenceType String?
  referenceId   String?                @db.Uuid
  actionUrl     String?
  data          Json?
  isRead        Boolean                @default(false)
  readAt        DateTime?
  expiresAt     DateTime?
  createdAt     DateTime               @default(now())
  deliveries    NotificationDelivery[]
  user          User                   @relation(fields: [userId], references: [id])

  @@unique([tenantId, userId, dedupeKey])
  @@index([tenantId, userId, isRead, createdAt])
  @@map("notifications")
}

model NotificationDelivery {
  id             String          @id @default(uuid(7)) @db.Uuid
  notificationId String          @db.Uuid
  channel        DeliveryChannel
  status         DeliveryStatus  @default(PENDING)
  attemptNumber  Int             @default(1)
  providerRef    String?
  providerCode   String?
  errorMessage   String?
  retryCount     Int             @default(0)
  deviceId       String?         @db.Uuid
  nextAttemptAt  DateTime?
  attemptedAt    DateTime        @default(now())
  deliveredAt    DateTime?
  notification   Notification    @relation(fields: [notificationId], references: [id])

  @@index([notificationId])
  @@map("notification_deliveries")
}

// ─────────────────────────────────────────────────────────────────────────────
// INFRASTRUCTURE (Platform outbox — HRMS has its own outbox_events table)
// ─────────────────────────────────────────────────────────────────────────────

model OutboxEvent {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenantId       String?   @db.Uuid
  eventKey       String
  payload        Json
  createdAt      DateTime  @default(now())
  availableAt    DateTime  @default(now())
  publishedAt    DateTime?
  lockedAt       DateTime?
  lockedBy       String?
  attemptCount   Int       @default(0)
  lastError      String?
  deadLetteredAt DateTime?

  @@index([publishedAt, deadLetteredAt, availableAt, createdAt], map: "outbox_events_delivery_idx")
  @@map("outbox_events")
}
